{
  "name": "ascii-fort",
  "version": "0.2.0",
  "description": "ASCII FORT — RPG 3D procédural rendu en caractères",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "checkpoint": "node scripts/checkpoint.mjs",
    "autosave": "node scripts/autosave.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@ascii-fort/core": "*",
    "@ascii-fort/ascii-engine": "*",
    "@ascii-fort/worldgen": "*",
    "@ascii-fort/sim": "*"
  }
}
